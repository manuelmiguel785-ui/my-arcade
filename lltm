const http = require('http');
const Unblocker = require('node-unblocker');

// Initialize the unblocker instance with default configurations
const unblocker = new Unblocker({
    prefix: '/proxy/' // All proxied URLs will route through this subdirectory
});

const server = http.createServer((req, res) => {
    // Forward the network request to the unblocker engine middleware
    unblocker(req, res, (err) => {
        if (err) {
            res.writeHead(500, {'Content-Type': 'text/plain'});
            res.end('Proxy Error: ' + err.message);
            return;
        }
        
        // Root path routing layout
        if (req.url === '/') {
            res.writeHead(200, {'Content-Type': 'text/html'});
            res.end(`
                <!DOCTYPE html>
                <html>
                <head><title>Search Utility</title></head>
                <body style="font-family:sans-serif; text-align:center; padding-top:100px;">
                    <h2>Web Proxy Router</h2>
                    <input type="text" id="url" placeholder="https://example.com" style="width:300px; padding:8px;">
                    <button onclick="go()" style="padding:8px 15px;">Go</button>
                    <script>
                        function go() {
                            const dest = document.getElementById('url').value;
                            if(dest) window.location.href = '/proxy/' + dest;
                        }
                    </script>
                </body>
                </html>
            `);
        } else {
            res.writeHead(404, {'Content-Type': 'text/plain'});
            res.end('404 Not Found');
        }
    });
});

// Bind server to default environment port variables or local fallback port 8080
const PORT = process.env.PORT || 8080;
server.listen(PORT, () => {
    console.log(`Proxy active infrastructure running on port ${PORT}`);
});

